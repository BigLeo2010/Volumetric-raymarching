#version 430 core

layout (local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(r32f, binding = 0) readonly uniform image3D uNoise;

layout(rgba8, binding = 1) writeonly uniform image3D uNormal;


ivec3 size = imageSize(uNoise);

float getDensity(int x, int y, int z){
    x = max(0, min(x, size.x - 1));
	y = max(0, min(y, size.y - 1));
    z = max(0, min(z, size.z - 1));
    return imageLoad(uNoise, ivec3(x,y,z)).r;
}

void main() {
    ivec3 pos = ivec3(gl_GlobalInvocationID.xyz);
    ivec3 size = imageSize(uNoise);

    if (pos.x >= size.x || pos.y >= size.y || pos.z >= size.z) {
        return;
    }

    float dx = getDensity(pos.x + 1, pos.y, pos.z) - getDensity(pos.x - 1, pos.y, pos.z);
	float dy = getDensity(pos.x, pos.y + 1, pos.z) - getDensity(pos.x, pos.y - 1, pos.z);
	float dz = getDensity(pos.x, pos.y, pos.z + 1) - getDensity(pos.x, pos.y, pos.z - 1);

    float nx = -dx;
	float ny = -dy;
	float nz = -dz;

	float len = sqrt(nx * nx + ny * ny + nz * nz) + 1e-6f;
	nx /= len;
	ny /= len;
	nz /= len;

    vec4 finalNormal;
	finalNormal.r = (nx * 0.5 + 0.5);
	finalNormal.g = (ny * 0.5 + 0.5);
	finalNormal.b = (nz * 0.5 + 0.5);

    imageStore(uNormal, pos, finalNormal);
}
