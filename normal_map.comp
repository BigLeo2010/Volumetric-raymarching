#version 430 core

layout (local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(r32f, binding = 0) readonly uniform image3D uNoise;

layout(rgba8, binding = 1) writeonly uniform image3D uNormal;

void main() {
    ivec3 pos = ivec3(gl_GlobalInvocationID.xyz);
    ivec3 size = imageSize(uNoise);

    if (pos.x >= size.x || pos.y >= size.y || pos.z >= size.z) {
        return;
    }

    ivec3 xm1 = clamp(pos - ivec3(1, 0, 0), ivec3(0), size - ivec3(1));
    ivec3 xp1 = clamp(pos + ivec3(1, 0, 0), ivec3(0), size - ivec3(1));

    ivec3 ym1 = clamp(pos - ivec3(0, 1, 0), ivec3(0), size - ivec3(1));
    ivec3 yp1 = clamp(pos + ivec3(0, 1, 0), ivec3(0), size - ivec3(1));

    ivec3 zm1 = clamp(pos - ivec3(0, 0, 1), ivec3(0), size - ivec3(1));
    ivec3 zp1 = clamp(pos + ivec3(0, 0, 1), ivec3(0), size - ivec3(1));

    float v_xp1 = imageLoad(uNoise, xp1).r;
    float v_xm1 = imageLoad(uNoise, xm1).r;

    float v_yp1 = imageLoad(uNoise, yp1).r;
    float v_ym1 = imageLoad(uNoise, ym1).r;

    float v_zp1 = imageLoad(uNoise, zp1).r;
    float v_zm1 = imageLoad(uNoise, zm1).r;

    float dx = v_xp1 - v_xm1;
    float dy = v_yp1 - v_ym1;
    float dz = v_zp1 - v_zm1;

    vec3 grad = vec3(dx, dy, dz);

    float len = length(grad) + 1e-6;

    vec3 normal = -grad / len;

    vec4 finalColor = vec4(normal * 0.5 + 0.5, 1.0);

    imageStore(uNormal, pos, finalColor);
}
