#version 430 core

// 1. Задаем размер локальной рабочей группы (в данном случае одномерная группа из 64 потоков)
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// 2. Привязываем буферы для чтения и записи данных
layout(std430, binding = 0) readonly buffer InputBuffer {
    float dataIn[];
};

layout(std430, binding = 1) writeonly buffer OutputBuffer {
    float dataOut[];
};

void main() {
    // 3. Получаем уникальный глобальный индекс текущего потока
    uint index = gl_GlobalInvocationID.x;
    
    // 4. Выполняем параллельное вычисление
    dataOut[index] = dataIn[index] * dataIn[index];
}
